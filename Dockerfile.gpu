# 热点信息搜集系统 - GPU 版 Docker配置
# 构建镜像: docker build -f Dockerfile.gpu -t hotsearch:gpu .
# 运行容器: docker run -d --gpus all --name hotsearch -p 8080:8080 hotsearch:gpu
#
# 前置要求:
#   1. 宿主机安装 NVIDIA 驱动 (>=525.x)
#   2. 安装 nvidia-container-toolkit
#      Ubuntu: sudo apt-get install -y nvidia-container-toolkit
#      然后重启 Docker: sudo systemctl restart docker

# 使用 CUDA 12.1 基础镜像（PyTorch 2.1+ 兼容）
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装 Python 3.12 + 系统依赖
RUN sed -i 's|archive.ubuntu.com|mirrors.tencent.com|g; s|security.ubuntu.com|mirrors.tencent.com|g' /etc/apt/sources.list 2>/dev/null || true \
    && for f in /etc/apt/sources.list.d/*.sources; do [ -f "$f" ] && sed -i 's|archive.ubuntu.com|mirrors.tencent.com|g; s|security.ubuntu.com|mirrors.tencent.com|g' "$f" || true; done \
    && apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOTSEARCH_ENVIRONMENT=production \
    HOTSEARCH_LOG_LEVEL=INFO \
    SERVICE_PORT=8080 \
    TZ=Asia/Shanghai

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖（先装 CUDA 版 torch，再装其余依赖）
RUN python3.12 -m pip install --no-cache-dir --break-system-packages \
    torch>=2.1.0 --index-url https://download.pytorch.org/whl/cu121 \
    && python3.12 -m pip install --no-cache-dir --break-system-packages \
    -i https://mirrors.tencent.com/pypi/simple/ -r requirements.txt

# 复制项目文件
COPY . .

# 创建必要的目录
RUN mkdir -p outputs logs .llm_cache .model_cache \
    outputs/json outputs/markdown outputs/analysis outputs/insight

# 设置权限
RUN chmod +x *.sh 2>/dev/null || true

# 暴露端口
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# 启动命令
CMD ["python", "main.py", "server"]
