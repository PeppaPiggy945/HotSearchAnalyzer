# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.conf text eol=lf

# Shell scripts
*.sh text eol=lf

# Makefile
Makefile text eol=lf

# HTML/CSS/JS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Configuration files
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Documents
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Model files
*.bin binary
*.safetensors binary
*.pt binary
*.pth binary

# Certificate files
*.pem binary
*.crt binary
*.key binary

# Cookie files
crawlers/cookies/*.json binary
