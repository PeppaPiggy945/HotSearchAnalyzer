# ==================== 环境配置 ====================
# 运行环境: development, testing, production
HOTSEARCH_ENVIRONMENT=production

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
HOTSEARCH_LOG_LEVEL=INFO

# ==================== 服务配置 ====================
# 服务端口
SERVICE_PORT=8080

# API访问密钥（用于API接口认证）
API_KEY=your-secret-api-key-here

# 是否启用调试模式
DEBUG=false

# ==================== AI平台API密钥 ====================
# OpenAI配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Claude配置
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here
CLAUDE_API_BASE=https://api.anthropic.com/v1

# DeepSeek配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 通义千问配置
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 邮件通知配置 ====================
# SMTP服务器
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# 发送者邮箱
SENDER_EMAIL=your-email@qq.com

# 邮箱密码或授权码
SENDER_PASSWORD=your-email-password-or-authorization-code

# 接收者邮箱（多个用逗号分隔）
RECIPIENT_EMAILS=recipient1@qq.com,recipient2@qq.com

# ==================== 代理配置 ====================
# HTTP代理（可选）
HTTP_PROXY=http://127.0.0.1:7890

# HTTPS代理（可选）
HTTPS_PROXY=http://127.0.0.1:7890

# 不使用代理的地址
NO_PROXY=localhost,127.0.0.1

# ==================== 数据库配置（可选）====================
# 如果使用数据库存储数据，请配置以下参数

# 数据库类型: sqlite, mysql, postgresql
DB_TYPE=sqlite

# SQLite数据库文件路径
DB_PATH=outputs/hotsearch.db

# MySQL配置（DB_TYPE=mysql时使用）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotsearch
DB_USER=hotsearch
DB_PASSWORD=your-database-password

# PostgreSQL配置（DB_TYPE=postgresql时使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hotsearch
POSTGRES_USER=hotsearch
POSTGRES_PASSWORD=your-database-password

# ==================== 缓存配置 ====================
# 是否启用缓存
CACHE_ENABLED=true

# 缓存有效期（秒）
CACHE_TTL=3600

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 定时任务配置 ====================
# 定时任务开关
SCHEDULER_ENABLED=false

# Cron表达式（秒 分 时 日 月 周）
# 示例：'0 */2 * * *' 表示每2小时执行一次
SCHEDULER_CRON='0 */2 * * *'

# 间隔时间（秒），与Cron二选一
# SCHEDULER_INTERVAL=7200

# ==================== 文件存储配置 ====================
# 数据输出目录
OUTPUT_DIR=outputs

# 日志目录
LOG_DIR=logs

# 缓存目录
CACHE_DIR=.llm_cache

# 临时文件目录
TEMP_DIR=/tmp/hotsearch

# ==================== 安全配置 ====================
# 最大请求大小（MB）
MAX_REQUEST_SIZE=100

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=5

# 是否启用IP白名单
IP_WHITELIST_ENABLED=false

# IP白名单（多个用逗号分隔）
IP_WHITELIST=127.0.0.1,::1

# ==================== 监控配置 ====================
# 是否启用健康检查
HEALTH_CHECK_ENABLED=true

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=60

# 是否启用性能监控
PERFORMANCE_MONITORING_ENABLED=false

# 性能数据保存天数
PERFORMANCE_DATA_RETENTION_DAYS=7

# ==================== 通知配置 ====================
# 是否启用邮件通知
EMAIL_NOTIFICATION_ENABLED=false

# 是否启用钉钉通知
DINGTALK_NOTIFICATION_ENABLED=false

# 钉钉Webhook地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token

# 钉钉密钥
DINGTALK_SECRET=your-secret

# ==================== 备份配置 ====================
# 是否启用自动备份
BACKUP_ENABLED=false

# 备份目录
BACKUP_DIR=backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 备份时间（Cron表达式）
BACKUP_CRON='0 2 * * *'

# ==================== 高级配置 ====================
# 是否启用数据压缩
DATA_COMPRESSION=false

# 是否启用日志轮转
LOG_ROTATION_ENABLED=true

# 日志文件最大大小（MB）
LOG_MAX_SIZE=10

# 日志保留数量
LOG_BACKUP_COUNT=5

# 是否启用请求限流
RATE_LIMIT_ENABLED=true

# 限流阈值（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# ==================== 开发配置 ====================
# 测试模式
TEST_MODE=false

# 是否使用模拟数据
MOCK_DATA=false

# 是否启用详细日志
VERBOSE_LOGGING=false

# 是否启用调试输出
DEBUG_OUTPUT=false
